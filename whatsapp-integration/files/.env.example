NODE_ENV=development
# trace | debug | info | warn | error | fatal — one JSON object per log line
LOG_LEVEL=info

# ── Database (Supabase now → Aurora later) ────────────────────
# Pooled, port 6543 — Prisma Client at runtime (PgBouncer transaction mode)
DATABASE_URL="postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct, port 5432 — Prisma Migrate AND pg-boss (advisory locks, session state)
DIRECT_URL="postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:5432/postgres"

# ── Providers — flip these when AWS lands ─────────────────────
LLM_PROVIDER=anthropic          # → bedrock
EMBEDDING_PROVIDER=google       # → bedrock
STORAGE_PROVIDER=filesystem     # → s3

# User-facing generation (RAG_PLAN §9)
LLM_MODEL=claude-sonnet-5
# Summarisation, fact extraction, eval grading — anything not user-facing
LLM_MODEL_BACKGROUND=claude-sonnet-5
# Only needed for an identity-linked API key (Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# Cards use RETRIEVAL_DOCUMENT, queries RETRIEVAL_QUERY (RAG_PLAN §1).
# Native output is 3072 dims; we request 1536 and re-normalise the truncated
# Matryoshka prefix — changing either line requires a full re-embed (§6.4).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
GOOGLE_API_KEY=
# Alternative embedding provider, unused while EMBEDDING_PROVIDER=google
OPENAI_API_KEY=

# filesystem provider
STORAGE_LOCAL_PATH=./.storage
# s3 provider (unused until AWS)
S3_BUCKET=
S3_REGION=

# ── Meta Cloud API ────────────────────────────────────────────
# Leave all four blank to run without a WhatsApp channel: the webhook is then
# not mounted and the worker registers a handler that fails loudly. Set any one
# of them and all four are required — a half-configured channel would serve an
# endpoint that cannot verify a signature.
#
# App dashboard → WhatsApp → API Setup. This is the ID, not the phone number.
WHATSAPP_PHONE_NUMBER_ID=
# A permanent System User token (Business Settings → Users → System Users).
# The token shown on the API Setup page is a 24-hour test token.
WHATSAPP_ACCESS_TOKEN=
# Any string you invent. Meta echoes it back once, during the GET handshake,
# and you paste the same value into the webhook configuration form.
WHATSAPP_VERIFY_TOKEN=
# App dashboard → Settings → Basic → App Secret. Signs every delivery. Required:
# without it the public webhook URL accepts fabricated customer messages.
WHATSAPP_APP_SECRET=
# Pinned deliberately. Meta retires a version about two years after release and
# a retired one starts answering 400 with no deprecation warning.
WHATSAPP_API_VERSION=v21.0
# Prior messages replayed into the prompt. Six is three exchanges.
WHATSAPP_HISTORY_TURNS=6
# Longer questions are truncated, never rejected.
WHATSAPP_MAX_QUERY_CHARS=1000
# Turns per minute per phone number. Each is one embedding + one Claude call.
WHATSAPP_RATE_LIMIT_PER_MINUTE=12
# Per Graph API request attempt.
WHATSAPP_REQUEST_TIMEOUT_SECONDS=15
# Largest webhook body accepted.
WHATSAPP_BODY_LIMIT=1mb
# Replies generated at once by one worker. Above 1, two messages sent seconds
# apart by the same person may be answered out of order.
WHATSAPP_WORKER_CONCURRENCY=3

# ── Dashboard auth ────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_ADMIN_DOMAIN=

# ── API + widget ──────────────────────────────────────────────
# Comma-separated. The browser half of the origin check; WidgetKey.allowedOrigins
# is the per-key half. An empty list is rejected rather than treated as "allow all".
WIDGET_ALLOWED_ORIGINS=http://localhost:8080
API_PORT=3001
API_HOST=0.0.0.0
# The origin browsers reach this API at. The widget iframe is served from
# /widget/frame, so its fetch to /chat is same-origin — and a same-origin POST
# still carries an Origin header. This value must be allowed or every widget
# request is a 403. Defaults to http://localhost:$API_PORT.
API_PUBLIC_ORIGIN=http://localhost:3001
# Chat turns per minute, per widget key and IP. Each turn is one embedding
# call plus one Claude call, both billed.
CHAT_RATE_LIMIT_PER_MINUTE=12
# Prior messages replayed into the prompt. Six is three exchanges.
CHAT_HISTORY_TURNS=6
# How long a visitor waits before the stream is closed with an error.
CHAT_TIMEOUT_SECONDS=45
API_BODY_LIMIT=32kb
